@@ -30,0 +31,2 @@ public class CubismRendererAndroid extends CubismRenderer {
+    private final Map<Integer, Float> drawableOpacityOverrides = new HashMap<>();
+
@@ -67,0 +70,17 @@ public class CubismRendererAndroid extends CubismRenderer {
+    /** Clears App-owned final drawable opacity values. */
+    public void clearDrawableOpacityOverrides() {
+        drawableOpacityOverrides.clear();
+    }
+
+    /** Sets an absolute final opacity for one drawable without changing model parameters. */
+    public void setDrawableOpacityOverride(int drawableIndex, float opacity) {
+        drawableOpacityOverrides.put(drawableIndex,
+            Math.max(0.0f, Math.min(1.0f, opacity)));
+    }
+
+    /** Returns the opacity used by the shader after applying an optional App override. */
+    public float getDrawableOpacityForRendering(int drawableIndex) {
+        Float override = drawableOpacityOverrides.get(drawableIndex);
+        return override == null ? getModel().getDrawableOpacity(drawableIndex) : override;
+    }
+
