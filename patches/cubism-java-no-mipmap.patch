+     * This is intentionally opt-in and empty by default. It lets an application prototype a
+     * foreground hand/arm pose without mutating immutable moc3 render-order data.
+     */
+    public void setForegroundDrawableIndices(int[] indices) {
+        int[] requested = indices == null ? EMPTY_DRAWABLE_INDICES : indices;
